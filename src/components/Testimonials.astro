---
const testimonials = [
  {
    quote: "I had the privilege of working with Eric at CareMessage. He is a thoughtful and impact-driven designer who approaches problems with a user-centered mindset. Eric effectively balances big-picture thinking with attention to detail. He builds and fosters strong relationships with product managers, engineers, and stakeholders. His clear communication regarding design decisions, along with his ability to advocate for users, makes him a trusted partner in achieving product outcomes.",
    name: "Sarah King",
    role: "Senior Product Designer – Healthcare Analytics @ IQVIA Digital",
  },
  {
    quote: "I'm a User Researcher at CareMessage, where Eric leads the product design across our Web App and Messaging Teams. We partner regularly throughout the design process, from planning usability testing to synthesizing findings. Eric is one of the strongest user advocates on our team. He doesn't just absorb research insights, he translates them directly into functionality and interfaces that work for our users. His curiosity has also led him to pioneer ways of using AI to prototype and iterate faster, speeding up the design process without cutting corners. His work is thoughtful, practical, and elegant, and would uplevel any team he's on.",
    name: "Raya Juitung Kuo",
    role: "Health Tech UX Researcher | Mixed-Methods | Social Impact & Human-Centered Design | Former Product Manager",
  },
];

const TRUNCATE_LENGTH = 180;
---

<section class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-16 py-8 sm:py-12">
  <div class="flex items-center gap-2 sm:gap-3 lg:w-[320px] lg:shrink-0">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" shape-rendering="crispEdges" class="shrink-0 text-[var(--color-accent)]"><path fill="currentColor" d="M2 2h12v1h-12zM1 3h1v1h-1zM14 3h1v1h-1zM1 4h1v1h-1zM14 4h1v1h-1zM1 5h1v1h-1zM5 5h2v1h-2zM9 5h2v1h-2zM14 5h1v1h-1zM1 6h1v1h-1zM5 6h2v1h-2zM9 6h2v1h-2zM14 6h1v1h-1zM1 7h1v1h-1zM5 7h1v1h-1zM9 7h1v1h-1zM14 7h1v1h-1zM1 8h1v1h-1zM14 8h1v1h-1zM1 9h1v1h-1zM14 9h1v1h-1zM1 10h1v1h-1zM14 10h1v1h-1zM2 11h12v1h-12zM3 12h2v1h-2zM3 13h1v1h-1z"/></svg>
    <h2 class="text-[28px] text-[var(--color-text)] font-normal leading-[1.2] whitespace-nowrap">Testimonials</h2>
  </div>

  <div class="flex flex-col gap-8 flex-1 lg:max-w-[700px]">
    {testimonials.map((t, i) => {
      const short = t.quote.slice(0, TRUNCATE_LENGTH).trimEnd();
      const needsTruncation = t.quote.length > TRUNCATE_LENGTH;
      return (
        <div class="pl-4 border-l-2 border-[var(--color-border)]">
          <p class="text-[15px] text-[var(--color-text)] leading-[1.7]">
            <span class="short-quote" data-index={i}>
              {needsTruncation ? short + '… ' : t.quote}
              {needsTruncation && (
                <button
                  class="read-more-btn inline text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 text-[13px]"
                  data-index={i}
                >
                  Read more ↓
                </button>
              )}
            </span>
            <span class="full-quote hidden" data-index={i}>
              {t.quote}{' '}
              <button
                class="read-less-btn inline text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 text-[13px]"
                data-index={i}
              >
                Read less ↑
              </button>
            </span>
          </p>
          <div class="mt-4">
            <p class="text-[15px] text-[var(--color-text)] font-medium">{t.name}</p>
            <p class="text-[13px] text-[var(--color-text-secondary)] mt-0.5">{t.role}</p>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  function initTestimonials() {
    document.querySelectorAll('.read-more-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = (btn as HTMLElement).dataset.index;
        const short = document.querySelector(`.short-quote[data-index="${idx}"]`) as HTMLElement;
        const full = document.querySelector(`.full-quote[data-index="${idx}"]`) as HTMLElement;
        short.classList.add('hidden');
        full.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.read-less-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = (btn as HTMLElement).dataset.index;
        const short = document.querySelector(`.short-quote[data-index="${idx}"]`) as HTMLElement;
        const full = document.querySelector(`.full-quote[data-index="${idx}"]`) as HTMLElement;
        full.classList.add('hidden');
        short.classList.remove('hidden');
      });
    });
  }

  document.addEventListener('astro:page-load', initTestimonials);
</script>
