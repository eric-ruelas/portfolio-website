---
const resumeUrl = import.meta.env.PUBLIC_RESUME_URL;

const jobs = [
  {
    title: 'Senior Product Designer',
    company: 'CareMessage',
    href: 'https://www.caremessage.org/',
    years: '2022–Present',
  },
  {
    title: 'Product Designer',
    company: 'Plexuss',
    href: 'https://plexuss.com/',
    years: '2019–2022',
  },
];
---

<section id="work" class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-16 py-8 sm:py-12">
  <div class="lg:w-[320px] lg:shrink-0">
    <div class="flex items-center gap-2 sm:gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" shape-rendering="crispEdges" class="shrink-0 text-[var(--color-accent)]"><path fill="currentColor" d="M2 3h4v1h-4zM1 4h1v1h-1zM6 4h7v1h-7zM1 5h1v1h-1zM13 5h1v1h-1zM1 6h13v1h-13zM1 7h1v1h-1zM13 7h1v1h-1zM1 8h1v1h-1zM13 8h1v1h-1zM1 9h1v1h-1zM13 9h1v1h-1zM1 10h1v1h-1zM13 10h1v1h-1zM1 11h13v1h-13z"/></svg>
      <h2 class="text-[28px] text-[var(--color-text)] font-normal leading-[1.2] whitespace-nowrap">Work Experience</h2>
    </div>

    <script>
      function initWorkExperience() {
        const cvBtn = document.getElementById('download-cv-btn') as HTMLElement;
        cvBtn?.addEventListener('click', () => {
          const url = cvBtn.dataset.url ?? '';
          if (url) window.open(url, '_blank', 'noopener,noreferrer');
        });

        document.querySelectorAll<HTMLAnchorElement>('[data-bg-link]').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const w = window.open(link.href, '_blank', 'noopener,noreferrer');
            if (w) { w.blur(); window.focus(); }
          });
        });
      }

      document.addEventListener('astro:page-load', initWorkExperience);
    </script>
  </div>

  <div class="flex flex-col gap-2 flex-1 lg:max-w-[700px]">
    <button
      id="download-cv-btn"
      data-url={resumeUrl}
      class="inline-flex items-center gap-1.5 mb-2 text-[13px] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 cursor-pointer self-end"
    >
      Download Resume
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 16 16" shape-rendering="crispEdges" class="shrink-0"><path fill="currentColor" d="M7 1h1v1h-1zM7 2h1v1h-1zM7 3h1v1h-1zM7 4h1v1h-1zM7 5h1v1h-1zM4 6h1v1h-1zM7 6h1v1h-1zM10 6h1v1h-1zM5 7h1v1h-1zM7 7h1v1h-1zM9 7h1v1h-1zM6 8h3v1h-3zM7 9h1v1h-1zM2 11h1v1h-1zM12 11h1v1h-1zM2 12h1v1h-1zM12 12h1v1h-1zM2 13h11v1h-11z"/></svg>
    </button>

    {jobs.map((job) => (
      <div class="py-4 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
        {job.href ? (
          <a href={job.href} data-bg-link class="text-[22px] text-[var(--color-text)] font-normal leading-[1.2] shrink-0 hover:text-[var(--color-accent)] transition-colors duration-150">{job.company}</a>
        ) : (
          <span class="text-[22px] text-[var(--color-text)] font-normal leading-[1.2] shrink-0">{job.company}</span>
        )}
        <span class="hidden sm:block flex-1 border-b border-dotted border-[var(--color-border)] mb-[0.2em]"></span>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg border border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)] text-[var(--color-accent)] text-[13px]">
            {job.title}
          </span>
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg border border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)] text-[var(--color-accent)] text-[13px]">
            {job.years}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
