<section class="flex-1 flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12 px-6 py-10">
  <div class="flex-1 flex flex-col justify-center">
    <div class="flex flex-col gap-6 sm:gap-10 max-w-[640px]">
      <h1 class="text-[32px] sm:text-[48px] text-[#343844] font-normal leading-[1.1] tracking-[-0.03em]">
        Designing products that put people first.
      </h1>

      <div class="flex flex-col gap-3 sm:gap-4">
        <p class="text-[15px] text-[#5c6168] leading-[1.6]">
          Currently at <a href="https://www.caremessage.org/" target="_blank" rel="noopener noreferrer" class="text-[#3d4c74] hover:underline">CareMessage</a>, designing complex software that's simple to use,
          with a focus on healthcare tools for underserved communities.
        </p>

        <div class="text-[13px] text-[#7a7f87] leading-[1.5]">
          <p>San Francisco Bay Area, USA</p>
          <p id="local-time">&nbsp;</p>
        </div>
      </div>
    </div>
  </div>

  <div class="shrink-0 w-full lg:w-[360px] xl:w-[420px]">
    <div class="overflow-hidden h-[320px] sm:h-[420px] lg:h-[480px] xl:h-[540px] w-full">
      <img
        src="/images/eric-portrait.jpg"
        alt="Eric Ruelas"
        width="1333"
        height="2000"
        class="w-full h-full object-cover block"
      />
    </div>
  </div>
</section>

<script>
  let clockIntervalId: ReturnType<typeof setInterval> | undefined;

  function updateLocalTime() {
    const el = document.getElementById('local-time');
    if (!el) return;
    const formatted = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
      timeZoneName: 'short',
    }).format(new Date());
    el.textContent = formatted;
  }

  function initClock() {
    if (!document.getElementById('local-time')) return;
    clearInterval(clockIntervalId);
    updateLocalTime();
    clockIntervalId = setInterval(updateLocalTime, 1000);
  }

  document.addEventListener('astro:page-load', initClock);
</script>
