---
const message = "On parental leave until November 4, 2026 — replies will be slower than usual";
---

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

<div class="w-full overflow-hidden bg-[#3d4c74] text-[#f9f8f6]">
  <div class="marquee-track py-2">
    {Array.from({ length: 2 }).map(() => (
      <span class="flex items-center shrink-0" aria-hidden="true">
        {Array.from({ length: 6 }).map(() => (
          <span class="flex items-center shrink-0 px-6 text-[13px] whitespace-nowrap">
            <span class="mr-6" role="img" aria-label="">👶</span>
            {message}
          </span>
        ))}
      </span>
    ))}
  </div>
  <span class="sr-only">{message}</span>
</div>
