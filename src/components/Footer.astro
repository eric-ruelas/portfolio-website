---
import DotGridIcon from './DotGridIcon.astro';
const email = import.meta.env.PUBLIC_EMAIL ?? '';

const links = [
  { label: 'LinkedIn', handle: 'in/ericruelas', href: 'https://www.linkedin.com/in/ericruelas', rel: 'noopener noreferrer' },
  { label: 'GitHub', handle: '/eric-ruelas', href: 'https://github.com/eric-ruelas', rel: 'noopener noreferrer' },
  { label: 'X', handle: '@ericruelass', href: 'https://x.com/ericruelass', rel: 'noopener noreferrer' },
  { label: 'Freelance work', handle: 'ericruelas.design', href: 'https://ericruelas.design', rel: 'noopener' },
  { label: 'Email', handle: email, href: `mailto:${email}`, rel: undefined },
];

const icons: Record<string, string> = {
  LinkedIn: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.047c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  GitHub: '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.744.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>',
  X: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  'Freelance work': '<path d="M14 3a1 1 0 1 0 0 2h3.586l-9.293 9.293a1 1 0 1 0 1.414 1.414L19 6.414V10a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-6z"/><path d="M5 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H5V7h4a1 1 0 1 0 0-2H5z"/>',
  Email: '<path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.1 6.2a1 1 0 0 0 1.3 0L19.8 6H4.2zM20 7.9l-6.9 6a3 3 0 0 1-3.9 0L2 7.9V18.5c0 .3.2.5.5.5h15c.3 0 .5-.2.5-.5V7.9z"/>',
};
---

<footer class="px-6 pt-4 pb-10">
  <div class="bg-[#3d4c74] rounded-2xl px-5 sm:px-8 py-6 sm:py-8">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mb-6">
      <DotGridIcon seed="contact" color="white" />
      <h2 class="text-[28px] text-white font-normal leading-[1.2]">Contact</h2>
    </div>

    <div class="flex flex-col">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.label !== 'Email' ? '_blank' : undefined}
          rel={link.rel}
          data-track-contact={link.label.toLowerCase()}
          class="group flex flex-col sm:flex-row sm:items-baseline py-3 sm:py-4 gap-0.5 sm:gap-0 hover:opacity-70 transition-opacity duration-150"
        >
          <span class="flex items-center gap-2 text-[13px] sm:text-[15px] text-white/70 shrink-0">
            <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current shrink-0" set:html={icons[link.label]} />
            {link.label}
          </span>
          <span class="hidden sm:block flex-1 mx-4 border-b border-dotted border-white/20"></span>
          <span class="text-[15px] text-white font-medium shrink-0">{link.handle}</span>
        </a>
      ))}
    </div>

    <p class="text-[11px] text-white/45 font-mono mt-8">© 2026 - Eric Ruelas</p>
  </div>

  <p class="text-[11px] text-[#5c6168]/70 font-mono italic text-center mt-4">"I wish there was a way to know you're in the good old days, before you've actually left them"</p>
</footer>

<script>
  document.querySelectorAll('[data-track-contact]').forEach((el) => {
    el.addEventListener('click', () => {
      window.posthog?.capture('contact_clicked', {
        method: el.getAttribute('data-track-contact'),
        location: 'footer',
      });
    });
  });
</script>
