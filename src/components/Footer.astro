---
import DotGridIcon from './DotGridIcon.astro';
const email = import.meta.env.PUBLIC_EMAIL ?? '';

const links = [
  { label: 'LinkedIn', handle: 'in/ericruelas', href: 'https://www.linkedin.com/in/ericruelas', rel: 'noopener noreferrer' },
  { label: 'GitHub', handle: '/eric-ruelas', href: 'https://github.com/eric-ruelas', rel: 'noopener noreferrer' },
  { label: 'Freelance work', handle: 'ericruelas.design', href: 'https://ericruelas.design', rel: 'noopener' },
  { label: 'Email', handle: email, href: `mailto:${email}`, rel: undefined },
];
---

<footer class="px-6 pt-4 pb-10">
  <div class="bg-[#3d4c74] rounded-2xl px-5 sm:px-8 py-6 sm:py-8">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mb-6">
      <DotGridIcon seed="contact" color="white" />
      <h2 class="text-[28px] text-white font-normal leading-[1.2]">Contact</h2>
    </div>

    <div class="flex flex-col">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.label !== 'Email' ? '_blank' : undefined}
          rel={link.rel}
          data-track-contact={link.label.toLowerCase()}
          class="group flex flex-col sm:flex-row sm:items-baseline py-3 sm:py-4 gap-0.5 sm:gap-0 hover:opacity-70 transition-opacity duration-150"
        >
          <span class="text-[13px] sm:text-[15px] text-white/50 shrink-0">{link.label}</span>
          <span class="hidden sm:block flex-1 mx-4 border-b border-dotted border-white/20"></span>
          <span class="text-[15px] text-white font-medium shrink-0">{link.handle}</span>
        </a>
      ))}
    </div>

    <p class="text-[11px] text-white/30 font-mono mt-8">© 2026 - Eric Ruelas</p>
  </div>

  <p class="text-[11px] text-[#7a7f87]/50 font-mono italic text-center mt-4">"I wish there was a way to know you're in the good old days, before you've actually left them"</p>
</footer>

<script>
  document.querySelectorAll('[data-track-contact]').forEach((el) => {
    el.addEventListener('click', () => {
      window.posthog?.capture('contact_clicked', {
        method: el.getAttribute('data-track-contact'),
        location: 'footer',
      });
    });
  });
</script>
