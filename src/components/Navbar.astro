---
const pathname = Astro.url.pathname;
const isWork = pathname.startsWith('/work');
const isNotes = pathname.startsWith('/notes');
const isAbout = pathname.startsWith('/about');

const links = [
  { label: 'Work', href: '/work', active: isWork },
  { label: 'Notes', href: '/notes', active: isNotes },
  { label: 'About', href: '/about', active: isAbout },
];
---

<header class="px-6 pt-6">
  <nav class="flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0 hover:opacity-75 transition-opacity duration-150">
      <div class="w-10 h-10 rounded-[10px] overflow-hidden shrink-0">
        <img src="/images/profile.avif" alt="Eric Ruelas" width="256" height="256" class="w-full h-full object-cover block" />
      </div>
      <div class="flex flex-col leading-tight">
        <span class="text-[#343844] text-[18px] font-normal leading-none">Eric Ruelas</span>
        <span class="text-[#5c6168] text-[13px] font-normal leading-none mt-1">Product Designer</span>
      </div>
    </a>

    <div class="flex items-center gap-4 sm:gap-6 shrink-0">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[14px] transition-colors duration-150',
            link.active
              ? 'text-[#3d4c74] font-medium underline underline-offset-4 decoration-1'
              : 'text-[#5c6168] hover:text-[#3d4c74]'
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
