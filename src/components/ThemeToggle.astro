---

<button
  type="button"
  class="theme-toggle inline-flex items-center justify-center w-7 h-7 shrink-0 text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 cursor-pointer"
  aria-label="Toggle dark mode"
>
  <svg class="theme-toggle-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" shape-rendering="crispEdges"><path fill="currentColor" d="M6 2h4v1h-4zM4 3h5v1h-5zM3 4h5v1h-5zM2 5h5v1h-5zM2 6h5v1h-5zM2 7h5v1h-5zM2 8h5v1h-5zM2 9h5v1h-5zM12 9h1v1h-1zM3 10h5v1h-5zM11 10h2v1h-2zM3 11h9v1h-9zM4 12h7v1h-7zM5 13h4v1h-4z"/></svg>
  <svg class="theme-toggle-sun hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" shape-rendering="crispEdges"><path fill="currentColor" d="M7 1h2v1h-2zM2 2h1v1h-1zM7 2h2v1h-2zM13 2h1v1h-1zM3 3h1v1h-1zM12 3h1v1h-1zM5 4h6v1h-6zM4 5h8v1h-8zM4 6h8v1h-8zM1 7h2v1h-2zM4 7h8v1h-8zM13 7h2v1h-2zM1 8h2v1h-2zM4 8h8v1h-8zM13 8h2v1h-2zM4 9h8v1h-8zM4 10h8v1h-8zM5 11h6v1h-6zM3 12h1v1h-1zM12 12h1v1h-1zM2 13h1v1h-1zM7 13h2v1h-2zM13 13h1v1h-1zM7 14h2v1h-2z"/></svg>
</button>

<script>
  function applyThemeToggleIcons() {
    const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.querySelector('.theme-toggle-moon')?.classList.toggle('hidden', theme === 'dark');
      btn.querySelector('.theme-toggle-sun')?.classList.toggle('hidden', theme !== 'dark');
    });
  }

  function setTheme(next: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
    applyThemeToggleIcons();
  }

  function initThemeToggles() {
    applyThemeToggleIcons();
    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    });
  }

  document.addEventListener('astro:page-load', initThemeToggles);
</script>
