---
const username = 'eric-ruelas';
---

<section class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-16 py-8 sm:py-12">
  <div class="flex items-center gap-2 sm:gap-3 lg:w-[320px] lg:shrink-0">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" shape-rendering="crispEdges" class="shrink-0 text-[var(--color-accent)]"><path fill="currentColor" d="M3 2h3v1h-3zM3 3h1v1h-1zM5 3h1v1h-1zM10 3h3v1h-3zM3 4h3v1h-3zM10 4h1v1h-1zM12 4h1v1h-1zM4 5h1v1h-1zM10 5h3v1h-3zM4 6h1v1h-1zM11 6h1v1h-1zM4 7h1v1h-1zM11 7h1v1h-1zM4 8h8v1h-8zM4 9h1v1h-1zM4 10h1v1h-1zM3 11h3v1h-3zM3 12h1v1h-1zM5 12h1v1h-1zM3 13h3v1h-3z"/></svg>
    <h2 class="text-[28px] text-[var(--color-text)] font-normal leading-[1.2] whitespace-nowrap">Git Activity</h2>
  </div>

  <div class="flex-1 lg:max-w-[700px]">
    <p class="text-[11px] font-semibold tracking-widest uppercase text-[var(--color-text-secondary)] mb-3">Last 30 days</p>

    <!-- Grid populated client-side so data is always fresh -->
    <div id="git-grid" class="grid grid-cols-[repeat(30,minmax(0,1fr))] gap-1 w-full">
      {Array.from({ length: 30 }).map(() => (
        <div class="aspect-square w-full rounded-[3px] bg-[var(--color-surface-muted)] animate-pulse" />
      ))}
    </div>

    <div class="mt-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-0 sm:justify-between">
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[13px] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors"
      >
        github.com/{username}
      </a>
      <span id="git-total" class="text-[13px] text-[var(--color-text-secondary)] hidden"></span>
    </div>
  </div>
</section>

<script>
  const username = 'eric-ruelas';

  const colors: Record<number, string> = {
    0: 'var(--color-surface-muted)',
    1: 'var(--git-level-1)',
    2: 'var(--git-level-2)',
    3: 'var(--git-level-3)',
    4: 'var(--git-level-4)',
  };

  const labels: Record<number, string> = {
    0: 'No activity',
    1: 'Light activity',
    2: 'Moderate activity',
    3: 'Active',
    4: 'Very active',
  };

  // Custom instant tooltip — avoids the ~500ms native title delay.
  // Reused across page-loads instead of appended fresh each time.
  function getTooltip(): HTMLElement {
    let tooltip = document.getElementById('git-activity-tooltip');
    if (!tooltip) {
      tooltip = document.createElement('div');
      tooltip.id = 'git-activity-tooltip';
      Object.assign(tooltip.style, {
        position: 'fixed',
        background: '#343844',
        color: '#fff',
        padding: '4px 10px',
        borderRadius: '6px',
        fontSize: '12px',
        lineHeight: '1.5',
        pointerEvents: 'none',
        opacity: '0',
        transition: 'opacity 0.08s ease',
        whiteSpace: 'nowrap',
        zIndex: '50',
      });
      document.body.appendChild(tooltip);
    }
    return tooltip;
  }

  function showTooltip(e: MouseEvent, text: string) {
    const tooltip = getTooltip();
    tooltip.textContent = text;
    tooltip.style.opacity = '1';
    positionTooltip(e);
  }

  function positionTooltip(e: MouseEvent) {
    const tooltip = getTooltip();
    const x = e.clientX;
    const y = e.clientY;
    tooltip.style.left = `${x - tooltip.offsetWidth / 2}px`;
    tooltip.style.top  = `${y - 36}px`;
  }

  function hideTooltip() {
    getTooltip().style.opacity = '0';
  }

  async function loadActivity() {
    try {
      const res = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`,
        { signal: AbortSignal.timeout(6000) }
      );
      const data = await res.json();
      const contributions: { date: string; count: number; level: 0|1|2|3|4 }[] = data.contributions ?? [];
      const recent = contributions.slice(-30);

      const grid = document.getElementById('git-grid');
      if (!grid || recent.length === 0) return;

      grid.innerHTML = recent.map((cell) => `
        <button
          class="aspect-square w-full rounded-[3px] transition-transform duration-150 hover:scale-150 focus-visible:scale-150 focus-visible:outline-none"
          style="background-color: ${colors[cell.level]};"
          data-tip="${cell.date} · ${cell.count} contribution${cell.count !== 1 ? 's' : ''}"
          aria-label="${cell.date}: ${labels[cell.level]}"
        ></button>
      `).join('');

      grid.addEventListener('mouseover', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-tip]') as HTMLElement | null;
        if (btn) showTooltip(e as MouseEvent, btn.dataset.tip ?? '');
      });
      grid.addEventListener('mousemove', (e) => {
        if (getTooltip().style.opacity === '1') positionTooltip(e as MouseEvent);
      });
      grid.addEventListener('mouseout', hideTooltip);

      const total = recent.reduce((sum: number, c: { count: number }) => sum + c.count, 0);
      const totalEl = document.getElementById('git-total');
      if (total > 0 && totalEl) {
        totalEl.textContent = `${total} contributions in the last 30 days`;
        totalEl.classList.remove('hidden');
      }
    } catch {
      // API unavailable — leave skeleton as-is
    }
  }

  document.addEventListener('astro:page-load', loadActivity);
</script>
