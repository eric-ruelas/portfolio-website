---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<style is:global>
  .prose h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose p {
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  .prose ul, .prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose li {
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: 0.35rem;
  }
  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    opacity: 0.7;
  }
  .prose blockquote {
    border-left: 2px solid var(--color-border);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .prose code {
    font-family: 'Geist Mono', monospace;
    font-size: 13px;
    background: var(--color-accent-soft);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }
  .prose img {
    width: 100%;
    border-radius: 12px;
    margin: 2rem 0;
  }
</style>

<style>
  html[data-theme="dark"] :global(.signature-img) {
    filter: invert(1);
  }
</style>

<Layout
  title={`${note.data.title} — Eric Ruelas`}
  description={note.data.description}
  publishedTime={note.data.date.toISOString()}
  image={note.data.image}
  maxWidth="1200px"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": note.data.title,
    "description": note.data.description,
    "datePublished": note.data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Eric Ruelas",
      "url": "https://www.ericruelas.com"
    },
    "publisher": {
      "@type": "Person",
      "name": "Eric Ruelas",
      "url": "https://www.ericruelas.com"
    },
    "url": `https://www.ericruelas.com/notes/${note.id}`
  })} slot="head" />
  <div class="min-h-dvh flex flex-col">
    <Navbar />
    <main class="flex-1 px-6 py-8 sm:py-12">
      <div class="max-w-[700px] mx-auto">

        <div class="sticky top-0 z-20 bg-[var(--color-bg)] pt-4 pb-3 mb-2">
          <div
            id="read-progress-track"
            class="h-5 w-full border-2 border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 p-[3px]"
            style="image-rendering: pixelated;"
          >
            <div
              id="read-progress-fill"
              class="h-full border border-[var(--color-accent)] bg-[var(--color-accent)]"
              style="width: 0%;"
            ></div>
          </div>
        </div>

        <script>
          function initReadProgress() {
            const track = document.getElementById('read-progress-track');
            const fill = document.getElementById('read-progress-fill');
            const article = document.querySelector('article.prose');
            if (!track || !fill || !article) return;

            function update() {
              const articleTop = article!.getBoundingClientRect().top + window.scrollY;
              const articleHeight = (article as HTMLElement).offsetHeight;
              const consumed = Math.min(articleHeight, Math.max(0, (window.scrollY + window.innerHeight) - articleTop));
              const pct = (consumed / articleHeight) * 100;
              fill!.style.width = `${Math.min(100, Math.max(0, pct))}%`;
            }

            if (window.__readProgressHandler) {
              window.removeEventListener('scroll', window.__readProgressHandler);
              window.removeEventListener('resize', window.__readProgressHandler);
            }
            window.__readProgressHandler = update;
            window.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update);
            update();
          }

          document.addEventListener('astro:page-load', initReadProgress);
        </script>

        <a
          href="/notes"
          class="inline-flex items-center gap-1.5 text-[13px] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 mb-10"
        >
          <ArrowLeft size={13} strokeWidth={1.5} />
          All notes
        </a>

        <div class="mb-8">
          <p class="text-[13px] text-[var(--color-text-secondary)] mb-3">{formatDate(note.data.date)}</p>
          <h1 class="text-[28px] text-[var(--color-text)] font-normal leading-[1.25] mb-4">{note.data.title}</h1>
          <p class="text-[15px] text-[var(--color-text-secondary)] leading-[1.6]">{note.data.description}</p>
        </div>

        <hr class="border-[var(--color-border)] mb-8" />

        <article class="prose">
          <Content />
        </article>

        <div class="mt-12">
          <img src="/signature.svg" alt="Eric Ruelas" class="h-10 signature-img" />
        </div>

        <a
          href="/notes"
          class="inline-flex items-center gap-1.5 text-[13px] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors duration-150 mt-8"
        >
          <ArrowLeft size={13} strokeWidth={1.5} />
          Back to notes
        </a>

      </div>
    </main>
    <Footer />
  </div>
</Layout>
