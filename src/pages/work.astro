---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';

const projects = [
  {
    id: 'plexuss',
    title: 'Plexuss',
    images: ['/images/work/plexuss.jpg', '/images/work/plexuss-2.jpg'],
  },
  {
    id: 'u-fi',
    title: 'U-fi',
    images: ['/images/work/u-fi.jpg', '/images/work/u-fi-2.jpg'],
  },
  {
    id: 'unlimitedtutoring',
    title: 'UnlimitedTutoring.com',
    images: [
      '/images/work/unlimitedtutoring.jpg',
      '/images/work/unlimitedtutoring-2.jpg',
      '/images/work/unlimitedtutoring-3.jpg',
    ],
  },
  {
    id: 'bayan',
    title: 'Bayan',
    images: ['/images/work/bayan.jpg', '/images/work/bayan-2.jpg'],
  },
  {
    id: 'ncrf',
    title: 'National College Resources Foundation',
    images: ['/images/work/ncrf.jpg', '/images/work/ncrf-2.jpg'],
  },
];

const tiles = projects.flatMap((project) =>
  project.images.map((image) => ({ title: project.title, image }))
);
---

<Layout
  title="Work — Eric Ruelas"
  description="Past product design work by Eric Ruelas, including Plexuss, U-fi, UnlimitedTutoring.com, Bayan, and the National College Resources Foundation."
  maxWidth="1200px"
>
  <div class="min-h-dvh flex flex-col">
    <Navbar />
    <div class="flex-1 flex flex-col">
      <main class="flex-1 px-6 py-8 sm:py-12">
        <div class="flex items-center gap-2 sm:gap-3 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" shape-rendering="crispEdges" class="shrink-0 text-[var(--color-accent)]"><path fill="currentColor" d="M2 3h4v1h-4zM1 4h1v1h-1zM6 4h7v1h-7zM1 5h1v1h-1zM13 5h1v1h-1zM1 6h13v1h-13zM1 7h1v1h-1zM13 7h1v1h-1zM1 8h1v1h-1zM13 8h1v1h-1zM1 9h1v1h-1zM13 9h1v1h-1zM1 10h1v1h-1zM13 10h1v1h-1zM1 11h13v1h-13z"/></svg>
          <h1 class="text-[28px] text-[var(--color-text)] font-normal leading-[1.2]">Work</h1>
        </div>

        <p class="text-[15px] text-[var(--color-text-secondary)] leading-[1.6] mb-10">
          Full case studies for my current work are in progress. In the meantime, here's a look at past projects.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
          {tiles.map((tile, index) => (
            <button
              type="button"
              class="group relative aspect-square rounded-lg overflow-hidden flex items-end cursor-zoom-in"
              data-work-tile
              data-index={index}
            >
              <img
                src={tile.image}
                alt={tile.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/0 to-black/0"></div>
              <p class="relative w-full min-w-0 text-[13px] text-white font-medium leading-snug p-3 break-words text-left">
                {tile.title}
              </p>
            </button>
          ))}
        </div>
      </main>
      <Footer />
    </div>
  </div>

  <div
    id="work-lightbox"
    class="hidden fixed inset-0 z-50 items-center justify-center bg-black/80 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
  >
    <button id="lightbox-close" class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white transition-colors duration-150" aria-label="Close">
      <X size={28} strokeWidth={1.5} />
    </button>
    <button id="lightbox-prev" class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors duration-150 p-2" aria-label="Previous image">
      <ChevronLeft size={32} strokeWidth={1.5} />
    </button>
    <button id="lightbox-next" class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors duration-150 p-2" aria-label="Next image">
      <ChevronRight size={32} strokeWidth={1.5} />
    </button>
    <figure class="max-w-[1200px] w-full flex flex-col items-center gap-3">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg" />
      <figcaption class="text-[13px] text-white/70 flex items-center gap-2">
        <span id="lightbox-title"></span>
        <span id="lightbox-counter" class="text-white/40"></span>
      </figcaption>
    </figure>
  </div>
</Layout>

<script define:vars={{ images: tiles.map((t) => t.image), titles: tiles.map((t) => t.title) }}>
  function initWorkLightbox() {
    const lightbox = document.getElementById('work-lightbox');
    const imgEl = document.getElementById('lightbox-img');
    const titleEl = document.getElementById('lightbox-title');
    const counterEl = document.getElementById('lightbox-counter');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const closeBtn = document.getElementById('lightbox-close');
    const tileEls = document.querySelectorAll('[data-work-tile]');
    if (!lightbox || !imgEl || !titleEl || !counterEl || !prevBtn || !nextBtn || !closeBtn || !tileEls.length) return;

    let index = 0;

    function render() {
      imgEl.src = images[index];
      imgEl.alt = titles[index];
      titleEl.textContent = titles[index];
      counterEl.textContent = `${index + 1} / ${images.length}`;
    }

    function open(startIndex) {
      index = startIndex;
      render();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function next() {
      index = (index + 1) % images.length;
      render();
    }

    function prev() {
      index = (index - 1 + images.length) % images.length;
      render();
    }

    tileEls.forEach((tile) => {
      tile.addEventListener('click', () => {
        open(Number(tile.dataset.index));
      });
    });

    closeBtn.addEventListener('click', close);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    if (window.__workLightboxKeyHandler) {
      document.removeEventListener('keydown', window.__workLightboxKeyHandler);
    }
    function onKey(e) {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    }
    window.__workLightboxKeyHandler = onKey;
    document.addEventListener('keydown', onKey);
  }

  document.addEventListener('astro:page-load', initWorkLightbox);
</script>
