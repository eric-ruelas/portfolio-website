---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AboutMe from '../components/AboutMe.astro';
import WorkExperience from '../components/WorkExperience.astro';
import Testimonials from '../components/Testimonials.astro';
import GitActivity from '../components/GitActivity.astro';
---

<Layout
  title="About — Eric Ruelas"
  description="Eric Ruelas's work experience and skills as a Product Designer."
  maxWidth="1200px"
>
  <div class="min-h-dvh flex flex-col">
    <Navbar />
    <main class="flex-1">
      <div class="max-w-[700px] mx-auto">
        <AboutMe />
        <WorkExperience />
        <Testimonials />
        <GitActivity />
      </div>
    </main>
    <Footer />
  </div>
</Layout>
