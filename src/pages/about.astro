---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WorkExperience from '../components/WorkExperience.astro';
import Skills from '../components/Skills.astro';
import Playground from '../components/Playground.astro';
import Testimonials from '../components/Testimonials.astro';
import GitActivity from '../components/GitActivity.astro';
---

<Layout
  title="About — Eric Ruelas"
  description="Eric Ruelas's work experience and skills as a Product Designer."
  maxWidth="1200px"
>
  <Navbar />
  <div class="max-w-[700px]">
    <main>
      <WorkExperience />
      <Skills />
      <Playground />
      <Testimonials />
      <GitActivity />
    </main>
    <Footer />
  </div>
</Layout>
